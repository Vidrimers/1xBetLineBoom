{
  "name": "1xBetLineBoom",
  "version": "48.0.0",
  "description": "Сайт для ставок",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "test": "concurrently \"npm run test --workspace=server\" \"npm run test --workspace=client\"",
    "lint": "concurrently \"npm run lint --workspace=server\" \"npm run lint --workspace=client\"",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
